{
  "name": "@watchman/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Read-only MCP server for Watchman: four tools (attention, flow, spend, metrics) over the snapshot, stdio only.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "node bin/watchman-mcp.mjs",
    "contract": "tsx scripts/contract.ts --write",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@watchman/core": "*",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0"
  },
  "bin": {
    "watchman-mcp": "./bin/watchman-mcp.mjs"
  }
}
